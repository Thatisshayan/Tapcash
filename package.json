{
  "name": "tapcash",
  "version": "1.0.0",
  "private": true,
  "main": "src-electron/main.js",
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "audit:gate": "node scripts/audit-gate.mjs",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "monitoring:deploy": "betteruptime push --config better-uptime.yml",
    "monitoring:validate": "betteruptime validate --config better-uptime.yml",
    "sentry:upload-sourcemaps": "sentry-cli sourcemaps inject --org $SENTRY_ORG --project $SENTRY_PROJECT .next && sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT .next",
    "health:check": "curl -f http://localhost:3000/api/health",
    "desktop": "electron ."
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^11.4.0",
    "@tailwindcss/postcss": "^4",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "msw-trpc": "^2.0.1",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "19.3.0",
    "react-use": "^17.6.1",
    "resend": "^6.32.0",
    "tailwindcss": "^4",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@firebase/auth-types": "^0.13.1",
    "@firebase/firestore-types": "^3.0.4",
    "@firebase/functions-types": "^0.6.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "caniuse-lite": {
    "data": {}
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
